{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "modules/**/templates/**/*.hbs"
    ],
    "exclude": [
      "**/*.spec.ts",
      "**/*.test.ts",
      "**/*.mock.ts",
      "**/migrations/**",
      "test/**"
    ]
  }
}