NODE_ENV=development
PORT=3002

# ─── PostgreSQL (K8s via port-forward) ─────────────────────────────────
DATABASE_POSTGRES_HOST=localhost
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_NAME=domestic_postgres
DATABASE_POSTGRES_USER=domestic
DATABASE_POSTGRES_PASSWORD=postgres1234
DATABASE_POSTGRES_SYNCHRONIZE=false
DATABASE_POSTGRES_LOGGING=true
DATABASE_POSTGRES_TIMEZONE=Z

# ─── MongoDB ──────────────────────────────────
MONGO_URI=mongodb://mongo:27017/backend_database_mongo
DATABASE_MONGO_HOST=mongo
DATABASE_MONGO_PORT=27017
DATABASE_MONGO_NAME=backend_database_mongo
DATABASE_MONGO_LOGGING=false
DATABASE_MONGO_SYNCHRONIZE=false

# ─── RabbitMQ (K8s via port-forward) ─────────────────────────────────
QUEUE_RABBITMQ_HOST=localhost
QUEUE_RABBITMQ_PORT=5672
QUEUE_RABBITMQ_USER=domestic
QUEUE_RABBITMQ_PASS=backendapi123

# ─── Keycloak Admin (K8s via port-forward) ──────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=BACKEND
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Worker ────────────────────────────────────
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=60000
WORKER_DLQ_ENABLED=true

# ─── Logging ──────────────────────────────────
LOG_LEVEL=info
