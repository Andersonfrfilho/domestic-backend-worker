// --- ENTIDADES PRINCIPAIS ---

Table users {
  id uuid [pk]
  keycloak_id uuid [unique, note: 'ID vinculado ao Keycloak']
  full_name varchar
  is_contractor boolean [default: true]
  is_provider boolean [default: false]
  status varchar [default: 'PENDING']
  created_at timestamp [default: `now()` ]

  indexes {
    keycloak_id [name: "users_keycloak_idx"]
  }
}

Table provider_profiles {
  id uuid [pk]
  user_id uuid [ref: - users.id]
  business_name varchar
  description text
  average_rating decimal [default: 0]
  is_available boolean [default: true]
}

// --- TABELAS DE DADOS (INDEPENDENTES) ---

Table emails {
  id uuid [pk]
  email varchar [unique]
  is_verified boolean [default: false]
  created_at timestamp [default: `now()` ]
}

Table phones {
  id uuid [pk]
  number varchar [unique]
  type varchar [note: 'MOBILE, LANDLINE, WHATSAPP']
  is_verified boolean [default: false]
  created_at timestamp [default: `now()` ]
}

Table addresses {
  id uuid [pk]
  street varchar
  number varchar
  complement varchar
  neighborhood varchar
  city varchar
  state varchar
  zipcode varchar
  latitude decimal
  longitude decimal
  is_verified boolean [default: false]
  created_at timestamp [default: `now()` ]
}

// --- TABELAS DE LIGAÇÃO (MANY-TO-MANY) ---

// Relacionamentos para Usuários (Pessoa Física/Contratante)
Table user_emails {
  user_id uuid [ref: > users.id]
  email_id uuid [ref: > emails.id]
  label varchar [note: 'Ex: Pessoal, Recuperação']
  is_primary boolean [default: false]
  pk uuid [pk]
}

Table user_phones {
  user_id uuid [ref: > users.id]
  phone_id uuid [ref: > phones.id]
  label varchar [note: 'Ex: Celular, Recado']
  is_primary boolean [default: false]
  pk uuid [pk]
}

Table user_addresses {
  user_id uuid [ref: > users.id]
  address_id uuid [ref: > addresses.id]
  label varchar [note: 'Ex: Casa, Trabalho']
  is_primary boolean [default: false]
  pk uuid [pk]
}

// Relacionamentos para Perfis de Prestador (Profissional/Comercial)
Table provider_emails {
  provider_id uuid [ref: > provider_profiles.id]
  email_id uuid [ref: > emails.id]
  label varchar [note: 'Ex: Comercial, Agendamentos']
  is_primary boolean [default: false]
  pk uuid [pk]
}

Table provider_phones {
  provider_id uuid [ref: > provider_profiles.id]
  phone_id uuid [ref: > phones.id]
  label varchar [note: 'Ex: WhatsApp Comercial']
  is_primary boolean [default: false]
  pk uuid [pk]
}

Table provider_addresses {
  provider_id uuid [ref: > provider_profiles.id]
  address_id uuid [ref: > addresses.id]
  label varchar [note: 'Ex: Escritório, Local de Atendimento']
  is_primary boolean [default: false]
  pk uuid [pk]
}

// --- SERVIÇOS E AGENDAMENTOS ---

Table categories {
  id uuid [pk]
  name varchar
  slug varchar [unique]
  icon_url varchar
}

Table services {
  id uuid [pk]
  category_id uuid [ref: > categories.id]
  name varchar
  description text
}

Table provider_services {
  id uuid [pk]
  provider_id uuid [ref: > provider_profiles.id]
  service_id uuid [ref: > services.id]
  price_base decimal
  price_type varchar
}

Table service_requests {
  id uuid [pk]
  contractor_id uuid [ref: > users.id]
  provider_id uuid [ref: > provider_profiles.id]
  service_id uuid [ref: > services.id]
  address_id uuid [ref: > addresses.id]
  
  status varchar
  contractor_confirmed boolean [default: false]
  provider_confirmed boolean [default: false]
  
  description text
  scheduled_at timestamp
  price_final decimal
  created_at timestamp [default: `now()` ]
}

Table reviews {
  id uuid [pk]
  service_request_id uuid [ref: - service_requests.id]
  contractor_id uuid [ref: > users.id]
  provider_id uuid [ref: > provider_profiles.id]
  rating int
  comment text
  created_at timestamp
}

Table documents {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  document_type varchar
  document_url varchar
  status varchar
  verified_at timestamp
}
