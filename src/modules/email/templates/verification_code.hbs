<!--
  Paleta de cores do app (cawme/src/shared/constants/colors.ts)
  primary.DEFAULT  #1A45E8  palette.blue[500]
  primary.dark     #1438CC  palette.blue[600]
  primary.lighter  #C7D4FD  palette.blue[100]
  primary.surface  #EEF2FF  palette.blue[50]
  neutral.0        #FFFFFF
  neutral[50]      #F8FAFC
  neutral[100]     #F1F5F9
  neutral[200]     #E2E8F0
  neutral[400]     #94A3B8
  neutral[600]     #475569
  neutral[900]     #0F172A
  error[500]       #EF4444
-->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #F8FAFC;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    .container { max-width: 560px; margin: 32px auto; }
    .card {
      background: #FFFFFF;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .header {
      background: linear-gradient(135deg, #1A45E8 0%, #1438CC 100%);
      padding: 32px 24px;
      text-align: center;
    }
    .header h1 {
      color: #FFFFFF;
      font-size: 24px;
      font-weight: 700;
      margin: 0;
    }
    .header p {
      color: #C7D4FD;
      font-size: 14px;
      margin-top: 8px;
    }
    .body { padding: 40px 32px; }
    .greeting {
      font-size: 16px;
      color: #0F172A;
      margin-bottom: 8px;
    }
    .message {
      font-size: 14px;
      color: #475569;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .code-box {
      background: #EEF2FF;
      border: 2px dashed #C7D4FD;
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      margin-bottom: 24px;
    }
    .code-label {
      font-size: 12px;
      color: #7798F9;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }
    .code {
      font-size: 40px;
      font-weight: 800;
      color: #1A45E8;
      letter-spacing: 12px;
      font-family: 'Courier New', Courier, monospace;
    }
    .expires {
      text-align: center;
      font-size: 13px;
      color: #94A3B8;
      margin-bottom: 24px;
    }
    .expires strong { color: #EF4444; }
    .divider {
      height: 1px;
      background: #E2E8F0;
      margin: 24px 0;
    }
    .footer-text {
      font-size: 12px;
      color: #94A3B8;
      line-height: 1.8;
    }
    .footer-text a { color: #1A45E8; text-decoration: none; }
    .footer {
      text-align: center;
      padding: 24px 32px;
      background: #F1F5F9;
    }
    .footer-logo {
      font-size: 14px;
      font-weight: 700;
      color: #0F172A;
      margin-bottom: 4px;
    }
    .footer-copy {
      font-size: 12px;
      color: #94a3b8;
    }
    @media only screen and (max-width: 600px) {
      .container { margin: 16px; }
      .body { padding: 24px 20px; }
      .code { font-size: 32px; letter-spacing: 8px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <h1>🔐 Código de Verificação</h1>
        <p>Use o código abaixo para confirmar seu e-mail</p>
      </div>

      <div class="body">
        <p class="greeting">Olá{{#if name}}, {{name}}{{/if}}!</p>
        <p class="message">
          Recebemos uma solicitação de verificação para sua conta.
          Insira o código abaixo no aplicativo para continuar:
        </p>

        <div class="code-box">
          <div class="code-label">Código de verificação</div>
          <div class="code">{{code}}</div>
        </div>

        <p class="expires">⏱️ Este código expira em <strong>{{expiresIn}}</strong></p>

        <div class="divider"></div>

        <p class="footer-text">
          Se você não solicitou este código, pode ignorar este e-mail com segurança.
          Nenhuma alteração será feita na sua conta.
        </p>
        <p class="footer-text">
          Precisa de ajuda? Entre em contato com nosso suporte.
        </p>
      </div>

      <div class="footer">
        <div class="footer-logo">Domestic</div>
        <div class="footer-copy">© 2026 Domestic. Todos os direitos reservados.</div>
      </div>
    </div>
  </div>
</body>
</html>
