<!--
  Domestic - Email Template: Código de Verificação
  Paleta: #1A45E8 (primary) | #0F172A (dark) | #F8FAFC (light background)
  Design inspirado: Stripe, Figma, Notion, GitHub
-->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Confirme seu e-mail — Domestic</title>
  <style type="text/css">
    /* Reset */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    table { border-collapse: collapse; border-spacing: 0; }
    img { max-width: 100%; height: auto; display: block; }

    /* Body */
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      background-color: #F8FAFC;
      color: #0F172A;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Email Container */
    .email-wrapper {
      background-color: #F8FAFC;
      padding: 16px;
      width: 100%;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border-radius: 12px;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }

    /* Header - Premium Gradient */
    .email-header {
      background: linear-gradient(135deg, #1A45E8 0%, #1438CC 100%);
      padding: 48px 32px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .email-header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
    }

    .email-header-content {
      position: relative;
      z-index: 1;
    }

    .header-icon {
      font-size: 48px;
      margin-bottom: 16px;
      display: inline-block;
      animation: bounce 2s infinite;
    }

    .email-header h1 {
      color: #FFFFFF;
      font-size: 28px;
      font-weight: 700;
      margin: 0 0 8px 0;
      letter-spacing: -0.5px;
    }

    .email-header p {
      color: #C7D4FD;
      font-size: 15px;
      margin: 0;
      font-weight: 500;
    }

    /* Main Content */
    .email-body {
      padding: 48px 40px;
    }

    .greeting {
      font-size: 18px;
      font-weight: 600;
      color: #0F172A;
      margin-bottom: 16px;
    }

    .subtitle {
      font-size: 15px;
      color: #475569;
      line-height: 1.7;
      margin-bottom: 32px;
    }

    /* Code Section - Premium Style */
    .code-section {
      background: linear-gradient(135deg, #EEF2FF 0%, #F0F4FF 100%);
      border: 2px solid #C7D4FD;
      border-radius: 16px;
      padding: 32px;
      text-align: center;
      margin: 32px 0;
      position: relative;
    }

    .code-label {
      font-size: 11px;
      font-weight: 700;
      color: #1A45E8;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
      display: block;
    }

    .verification-code {
      font-size: 48px;
      font-weight: 900;
      color: #1A45E8;
      letter-spacing: 16px;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      margin: 0;
      line-height: 1;
    }

    .code-hint {
      font-size: 12px;
      color: #7798F9;
      margin-top: 12px;
      font-weight: 500;
    }

    /* Timer/Expiration */
    .expiration-box {
      background: linear-gradient(135deg, #FEF3C7 0%, #FEF9E7 100%);
      border: 2px solid #F59E0B;
      border-radius: 12px;
      padding: 20px;
      margin: 24px 0;
      text-align: center;
    }

    .expiration-header {
      font-size: 12px;
      font-weight: 700;
      color: #92400E;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
      display: block;
    }

    .timer-display {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .timer-icon {
      font-size: 28px;
    }

    .timer-text {
      font-size: 18px;
      font-weight: 700;
      color: #F59E0B;
      margin: 0;
    }

    .expiration-time {
      font-size: 13px;
      color: #78350F;
      margin: 8px 0 0 0;
      line-height: 1.6;
    }

    .expiration-time strong {
      display: block;
      font-size: 14px;
      color: #EF4444;
      font-weight: 700;
      margin-top: 4px;
    }

    .security-note {
      font-size: 12px;
      color: #92400E;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid rgba(245, 158, 11, 0.3);
      font-weight: 500;
    }

    /* Security Section */
    .security-section {
      background: #F1F5F9;
      border-radius: 12px;
      padding: 20px;
      margin: 32px 0;
    }

    .security-title {
      font-size: 13px;
      font-weight: 700;
      color: #0F172A;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .security-title::before {
      content: '🔒';
      font-size: 16px;
    }

    .security-item {
      font-size: 13px;
      color: #475569;
      line-height: 1.6;
      margin: 8px 0;
      display: flex;
      gap: 8px;
    }

    .security-item::before {
      content: '✓';
      color: #1A45E8;
      font-weight: bold;
      flex-shrink: 0;
    }

    /* FAQ/Help */
    .help-section {
      margin: 32px 0 0 0;
      padding-top: 24px;
      border-top: 1px solid #E2E8F0;
    }

    .help-title {
      font-size: 13px;
      font-weight: 700;
      color: #0F172A;
      margin-bottom: 12px;
    }

    .help-item {
      font-size: 13px;
      color: #475569;
      margin: 8px 0;
      line-height: 1.6;
    }

    .help-item a {
      color: #1A45E8;
      text-decoration: none;
      font-weight: 600;
    }

    .help-item a:hover {
      text-decoration: underline;
    }

    /* Divider */
    .divider {
      height: 1px;
      background: #E2E8F0;
      margin: 32px 0;
    }

    /* Footer */
    .email-footer {
      background-color: #F8FAFC;
      border-top: 1px solid #E2E8F0;
      padding: 32px 40px;
      text-align: center;
    }

    .footer-logo {
      font-size: 16px;
      font-weight: 700;
      color: #0F172A;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }

    .footer-copyright {
      font-size: 12px;
      color: #94A3B8;
      margin: 8px 0;
    }

    .footer-links {
      font-size: 12px;
      color: #94A3B8;
      margin-top: 16px;
    }

    .footer-links a {
      color: #1A45E8;
      text-decoration: none;
      font-weight: 500;
      margin: 0 8px;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media only screen and (max-width: 600px) {
      .email-wrapper { padding: 8px; }
      .email-header { padding: 32px 24px; }
      .email-body { padding: 32px 24px; }
      .email-footer { padding: 24px 20px; }
      .verification-code { font-size: 36px; letter-spacing: 12px; }
      .email-header h1 { font-size: 24px; }
      .greeting { font-size: 16px; }
      .code-section { padding: 24px; }
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-container">
      <!-- Header -->
      <div class="email-header">
        <div class="email-header-content">
          <div class="header-icon">🔐</div>
          <h1>Confirme seu e-mail</h1>
          <p>Use o código abaixo para completar seu cadastro</p>
        </div>
      </div>

      <!-- Body -->
      <div class="email-body">
        <p class="greeting">Bem-vindo{{#if name}} {{name}}{{/if}}! 👋</p>

        <p class="subtitle">
          Estamos felizes em tê-lo conosco. Para continuar, insira o código de verificação abaixo no aplicativo Domestic:
        </p>

        <!-- Code Box -->
        <div class="code-section">
          <span class="code-label">Seu código de verificação</span>
          <p class="verification-code">{{code}}</p>
          <p class="code-hint">Este é um código único para sua sessão</p>
        </div>

        <!-- Timer with Counter -->
        <div class="expiration-box">
          <span class="expiration-header">⏲️ Tempo Limitado</span>
          <div class="timer-display">
            <span class="timer-icon">🕐</span>
            <p class="timer-text">{{expiresIn}}</p>
          </div>
          <p class="expiration-time">
            Código expira em: <strong>{{expiresAt}}</strong>
          </p>
          <p class="security-note">🔒 Não compartilhe este código com ninguém. Domestic nunca pedirá este código.</p>
        </div>

        <!-- Security Info -->
        <div class="security-section">
          <div class="security-title">Por que recebi este e-mail?</div>
          <div class="security-item">Solicitação de criação de conta ou login</div>
          <div class="security-item">Verificação de segurança do seu perfil</div>
          <div class="security-item">Não foi você? Ignore este e-mail</div>
        </div>

        <!-- Help Section -->
        <div class="help-section">
          <p class="help-title">Precisa de ajuda?</p>
          <p class="help-item">
            Não consegue inserir o código? Verifique se está usando a versão mais recente do app.
          </p>
          <p class="help-item">
            Problemas persistentes? Entre em contato com nosso suporte: <a href="mailto:suporte@domestic.local">suporte@domestic.local</a>
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <div class="footer-logo">Domestic</div>
        <div class="footer-copyright">© 2026 Domestic. Todos os direitos reservados.</div>
        <div class="footer-links">
          <a href="#">Privacidade</a> •
          <a href="#">Termos</a> •
          <a href="#">Contato</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
